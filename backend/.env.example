# Provider mac dinh khi frontend khong chi dinh: "claude" hoac "gemini"
AI_PROVIDER=claude

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini
GEMINI_API_KEY=
