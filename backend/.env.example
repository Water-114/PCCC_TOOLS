# Provider mac dinh khi frontend khong chi dinh: "claude" hoac "gemini"
AI_PROVIDER=claude

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# CORS: origin cua frontend Vite khi chay local
FRONTEND_ORIGIN=http://localhost:5173

# Dang nhap
SECRET_KEY=doi-chuoi-nay-truoc-khi-dung-that-o-production

# Database:
# - Local dev (mac dinh khi bo trong/khong dat bien nay): SQLite file cuc bo,
#   khong can cai/chay gi them.
DATABASE_URL=sqlite:///app.db
#
# - Staging/Production (Render PostgreSQL): dan "Internal Database URL" tu
#   trang "Info" cua database tren Render Dashboard (dang postgres://...) —
#   code se tu doi "postgres://" thanh "postgresql://" cho SQLAlchemy.
#   Vi du (KHONG phai gia tri that, chi minh hoa cau truc):
# DATABASE_URL=postgres://user:password@dpg-xxxxxxxx-a.oregon-postgres.render.com/dbname
#
# - Sau khi doi DATABASE_URL sang Postgres lan dau, BAT BUOC chay "flask db
#   upgrade" thu cong 1 lan (qua Render Shell) truoc khi service nhan traffic —
#   xem docs/04-migration-runbook.md. Migration KHONG con tu chay luc web
#   instance start (tu Batch 2).

# So luot goi API doc ban ve toi da moi tai khoan / ngay
AIHO_DAILY_QUOTA=5
